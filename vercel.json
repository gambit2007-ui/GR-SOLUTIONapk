{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/loans", "destination": "/api/credigrupo/loans?route=direct" },
    { "source": "/api/bank-statement/preview", "destination": "/api/credigrupo/operations?route=bank-statement-preview" },
    { "source": "/api/credigrupo/gr-investor", "destination": "/api/credigrupo/investors?route=gr-investor" },
    { "source": "/api/credigrupo/investor-documents", "destination": "/api/credigrupo/investors?route=investor-documents" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
